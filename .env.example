# ==============================================================================
# 🛡️ CFTV-CENTINEL - Variáveis de Ambiente & Configurações de Segurança
# ==============================================================================

# --- Servidor & Aplicação ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
ENVIRONMENT=production # development | production
DEBUG=false
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# --- Autenticação & JWT ---
# IMPORTANTE: Gere uma chave forte para produção: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_super_secret_random_key_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Usuário Administrador Padrão (Criado automaticamente se users.json não existir) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin_cftv_change_me!
INITIAL_ADMIN_NAME="Administrador Central"

# --- Criptografia em Repouso (AES-256 Fernet para senhas de DVR/Câmeras) ---
# Gere uma chave Fernet com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Configurações de Monitoramento ---
CHECK_INTERVAL=45
CONNECTION_TIMEOUT=3.5
FAILURE_THRESHOLD=3
RECOVERY_THRESHOLD=2
MAX_CONCURRENT_CHECKS=8

# --- Gateway do WhatsApp Web (whatsapp-gateway) ---
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=cftv
WHATSAPP_TARGET_NUMBER=
WHATSAPP_SEND_SNAPSHOT=true

# --- Notificações Telegram ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SEND_SNAPSHOT=true
